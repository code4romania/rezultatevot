{
    "name": "code4romania/rezultatevot",
    "type": "project",
    "description": "Romanian election results app.",
    "keywords": [
        "code4romania",
        "laravel",
        "filament",
        "elections",
        "election results",
        "transparency"
    ],
    "license": "MPL-2.0",
    "require": {
        "php": "^8.4",
        "andreiio/blade-remix-icon": "^3.9",
        "archtechx/laravel-seo": "^0.10",
        "blade-ui-kit/blade-icons": "^1.9",
        "codeat3/blade-google-material-design-icons": "^1.20",
        "commitglobal/app-version": "^1.0",
        "commitglobal/enum-utils": "^1.0",
        "datlechin/filament-menu-builder": "dev-depfu/update/composer/filament/filament-4.8.1",
        "dedoc/scramble": "^0.13",
        "filament/filament": "^4.8",
        "filament/spatie-laravel-media-library-plugin": "^4.8",
        "haydenpierce/class-finder": "^0.5",
        "jeffgreco13/filament-breezy": "^3.0",
        "laravel/framework": "^12.53",
        "laravel/horizon": "^5.45",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^10.24",
        "laravel/tinker": "^2.11",
        "league/csv": "^9.28",
        "league/flysystem-aws-s3-v3": "^3.32",
        "league/flysystem-read-only": "^3.31",
        "livewire/livewire": "^3.7",
        "maatwebsite/excel": "^3.1",
        "sentry/sentry-laravel": "^4.21",
        "spatie/temporary-directory": "^2.3",
        "staudenmeir/belongs-to-through": "^2.17",
        "tpetry/laravel-query-expressions": "^1.5",
        "typesense/typesense-php": "^5.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "fakerphp/faker": "^1.24",
        "filament/upgrade": "~4.0",
        "friendsofphp/php-cs-fixer": "^3.94",
        "fruitcake/laravel-debugbar": "^4.1",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "laravel/telescope": "^5.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.11"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan filament:upgrade",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --nowrite"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": [
            "@php artisan test"
        ],
        "analyse": [
            "./vendor/bin/phpstan analyse"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
